# Spring Boot backend. Called directly from the browser — the controller
# sets @CrossOrigin(origins = "*"), so no proxy rewrite is needed.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Unsplash Access Key (the public one, NOT the secret key).
# Deliberately NOT prefixed with NEXT_PUBLIC_ — that would inline the value
# into the client bundle where anyone can read it. It is only ever read
# server-side by src/app/api/background/route.js.
# Get one at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
